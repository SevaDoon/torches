rules_version = '2';

// Every student signs in (name + PIN, via Firebase Auth), so the document id is
// her uid and she can only ever write her own row. The leaderboard needs to read
// the whole class, but only a signed-in student can read at all.
service cloud.firestore {
  match /databases/{database}/documents {

    // A teacher is simply a document in /teachers named after her uid. Only
    // someone with console access can create one, so a student cannot promote
    // herself by writing to Firestore.
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /teachers/{uid} {
      allow read: if request.auth != null;
      // A teacher may appoint or remove a co-teacher, but never remove herself
      // — that would let the last teacher lock everyone out of the class screen.
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if isTeacher() && request.auth.uid != uid;
    }

    match /students/{uid} {
      allow read: if request.auth != null;

      // Shape check applies to whoever writes: the student herself, or a
      // teacher resetting or renaming her.
      function validStudent() {
        return request.resource.data.id == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.xp is number
          && request.resource.data.xp >= 0;
      }

      // Every answer saves as it happens, so an honest write moves the score by
      // tens of points. The ceiling is set far above that on purpose: a student
      // whose connection drops mid-mission saves everything at once when it
      // comes back, and refusing that write would cost her real work. What it
      // does stop is the one-request fake score — becoming first place forever
      // now takes hundreds of sequential writes instead of a single one.
      function honestGain() {
        return request.resource.data.xp <= resource.data.xp + 10000;
      }

      // A new account starts at zero. Nobody arrives with a score.
      allow create: if request.auth != null
        && (request.auth.uid == uid || isTeacher())
        && validStudent()
        && (isTeacher() || request.resource.data.xp == 0);

      allow update: if request.auth != null
        && (request.auth.uid == uid || isTeacher())
        && validStudent()
        && (isTeacher() || honestGain());

      // Only a teacher can clear a student's record.
      allow delete: if isTeacher();
    }
  }
}
