rules_version = '2';

// Every student signs in (name + PIN, via Firebase Auth), so the document id is
// her uid and she can only ever write her own row. The leaderboard needs to read
// the whole class, but only a signed-in student can read at all.
service cloud.firestore {
  match /databases/{database}/documents {

    // A teacher is simply a document in /teachers named after her uid. Only
    // someone with console access can create one, so a student cannot promote
    // herself by writing to Firestore.
    function isTeacher() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /teachers/{uid} {
      allow read: if request.auth != null;
      allow write: if false; // console / admin API only
    }

    match /students/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.xp is number
        && request.resource.data.xp >= 0;

      // Only a teacher can clear a student's record.
      allow delete: if isTeacher();
    }
  }
}
